{
  "name": "discord-client",
  "productName": "Discord Client",
  "version": "0.1.0",
  "description": "A lightweight Discord client built with Rust and Tauri",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/CHEAPFISS/discord-client.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "fe:build": "esbuild src/app.ts --bundle --format=esm --target=es2022 --outfile=src/app.js",
    "fe:watch": "esbuild src/app.ts --bundle --format=esm --target=es2022 --outfile=src/app.js --watch",
    "fe:check": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check": "npm run fe:check && npm run i18n:check && npm run fe:build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
